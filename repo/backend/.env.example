# AI provider: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here

# SQLite for local dev; use postgresql://user:pass@host:5432/db for PostgreSQL
DATABASE_URL=sqlite:///realestate.db
CORS_ORIGINS=http://localhost:5173

# Agent dashboard sign-in (change these!)
SECRET_KEY=change-me-to-a-long-random-string
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me

# WhatsApp Cloud API (Meta). Leave blank to disable the gateway.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_ALLOW_UNSIGNED=false
